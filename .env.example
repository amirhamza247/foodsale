# Optional shared persistent index (Vercel Storage -> Upstash Redis injects these).
# Set as environment variables; app.py does not automatically load .env files.
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR-SERVER-SIDE-TOKEN

# Alternative names KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
# Local use defaults to .foodsale/price-index.sqlite3 (ignored by Git).
# Hosting with a persistent writable disk may explicitly set:
# FOODSALE_PRICE_INDEX_PATH=/data/foodsale/price-index.sqlite3
